# Copie para .env e ajuste. O .env nunca vai para o Git.
# Todas as variaveis usam o prefixo CREDIT_ (definido em config.py).

# --- Aplicacao ---
CREDIT_AMBIENTE=local
CREDIT_DEBUG=false

# --- API ---
CREDIT_HOST=0.0.0.0
CREDIT_PORTA=8000

# --- Logging ---
# Em local, log_json=false deixa a saida legivel no terminal.
CREDIT_NIVEL_LOG=INFO
CREDIT_LOG_JSON=false

# --- Regras de negocio ---
CREDIT_TAXA_JUROS_PADRAO_MENSAL=1.99
CREDIT_PRAZO_MAXIMO_MESES=120

# --- Bureau de credito ---
CREDIT_BUREAU_HABILITADO=true
CREDIT_BUREAU_TIMEOUT_SEGUNDOS=3.0

# --- RAG ---
# Vazio = API sobe sem o indice de politicas (endpoints /v1/politicas dao 503
# com instrucao). Preencher para usar pgvector.
CREDIT_POSTGRES_DSN=postgresql://credito:credito_local@localhost:5432/credito

# Os testes de integracao derivam <banco>_test deste DSN e nunca tocam o banco
# de desenvolvimento — eles truncam a tabela.
# CREDIT_POSTGRES_DSN_TEST=postgresql://credito:credito_local@localhost:5432/credito_test

# 1024 dimensoes. Trocar exige ALTER da coluna vector() e reingestao completa.
CREDIT_MODELO_EMBEDDING=intfloat/multilingual-e5-large
CREDIT_TRECHOS_POR_CONSULTA=5

# --- LLM ---
# Qual adapter usar: auto | ollama | anthropic | fake
#
#   auto      (padrao) tenta Anthropic se houver chave, senao Ollama se o
#             daemon responder, senao cai no fake. Nunca quebra a subida.
#   ollama    forca o modelo local. Falha na subida se o daemon nao responder,
#             em vez de silenciosamente virar fake.
#   anthropic forca a API. Falha na subida se nao houver chave.
#   fake      deterministico, sem rede. E o que a suite de testes usa.
CREDIT_PROVEDOR_LLM=auto

# --- LLM local (Ollama) ---
# Zero chave, zero conta, e o dado nao sai da infraestrutura — o argumento que
# pesa mais que o preco numa esteira de credito com CPF e renda no prompt.
#   winget install Ollama.Ollama && ollama pull llama3.1:8b
# Ver a medicao que justifica o modelo no cabecalho de
# infrastructure/llm/ollama_adapter.py.
CREDIT_OLLAMA_ENDPOINT=http://127.0.0.1:11434
CREDIT_MODELO_OLLAMA=llama3.1:8b
# Inferencia em CPU: ~70s para um 8B. O timeout precisa acomodar isso.
CREDIT_OLLAMA_TIMEOUT_SEGUNDOS=240

# --- LLM remoto (Anthropic, opcional) ---
# Sem chave o servico nao quebra: cai para Ollama ou para o fake.
# Com chave, o modelo de visao tambem entra na cadeia de OCR como escalonamento.
# CREDIT_ANTHROPIC_API_KEY=sk-ant-...
CREDIT_MODELO_LLM=claude-opus-5
CREDIT_LLM_TIMEOUT_SEGUNDOS=60

# --- Agente (Camada 4) ---
# Modelo DIFERENTE do da fundamentacao, por medicao: qwen2.5:7b abstem-se
# corretamente 4/4 quando a pergunta nao exige ferramenta; llama3.1:8b, 0/4 —
# ele chama ferramenta ate para "Bom dia". Na fundamentacao a ordem se inverte.
#   ollama pull qwen2.5:7b
CREDIT_MODELO_AGENTE=qwen2.5:7b

# Teto de execucoes de ferramenta por atendimento: a protecao contra o modelo
# que nao sabe parar. No limite, o agente responde com o que apurou, usando uma
# chamada final sem nenhuma ferramenta vinculada.
CREDIT_AGENTE_MAX_PASSOS=6

# Orcamento do atendimento inteiro, nao de uma chamada ao modelo. ~80s por
# resposta com uma ferramenta, em CPU.
CREDIT_AGENTE_TIMEOUT_SEGUNDOS=180

# --- OCR ---
# Opcional: sobrepoe a busca automatica do binario do Tesseract (PATH e
# caminhos usuais do Windows). Sem Tesseract e sem chave Anthropic, os
# endpoints de documento respondem 503 com instrucao.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
