{
  "python.defaultInterpreterPath": "${workspaceFolder}/services/credit-analysis/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/services/credit-analysis/src"],
  "python.analysis.typeCheckingMode": "standard",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["services/credit-analysis"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  }
}
